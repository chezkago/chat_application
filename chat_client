//CLIENT
#include <stdlib.h>
#include <stdio.h>
#include <sys/socket.h> //for calling socket function
#include <netinet/in.h>
#include <arpa/inet.h>
#include <string.h>
#include <malloc.h>
#include <stdbool.h>
#include <unistd.h>
#include <pthread.h>

struct sockaddr_in* createIPv4Address(char *ip, int port);

int createTCPIpv4Socket();
void* listenAndPrint(void* arg);
void startListeningAndPrintMessagesOnNewThread(int socketFD);

//Purpose: construct code to some server
struct sockaddr_in* createIPv4Address(char *ip, int port){
        struct sockaddr_in *address = malloc(sizeof(struct sockaddr_in));     //allocate 16 bytes and return pointer inside it
                                        //SETTING PROPERTIES OF ADDRESS
        address->sin_family = AF_INET;           //address family --> IPV4
        address->sin_port = htons(port);           //assigning port number  //htons --> puts bytes in correct order

        if(strlen(ip) ==0)
                address->sin_addr.s_addr= INADDR_ANY;           //listen for any incoming address, constant used only on server side

        else
                inet_pton(AF_INET, ip, &address->sin_addr.s_addr); //convert presenation form of ip address to unsigned integer
        return address;
}//end struct

int createTCPIpv4Socket(){
         //3 parameters: domain --> address family (IPV4), type of socket (TCP), protocol (want IP layer)
        return socket(AF_INET, SOCK_STREAM, 0);
}

void startListeningAndPrintMessagesOnNewThread(int socketFD){
        pthread_t id;
        int* socketFD_ptr = malloc(sizeof(int));
        *socketFD_ptr = socketFD;

        //Creates new thread
        pthread_create(&id, NULL, listenAndPrint, socketFD_ptr);
        pthread_detach(id);
}

void* listenAndPrint(void* arg){        //THREAD FUNCTION    recieves message from server and prints them
        int socketFD = *((int*)arg);
        free(arg);

        char buffer[1024];
        while(true){
                ssize_t amountReceived = recv(socketFD, buffer, 1024, 0);

                if(amountReceived >0){
                        buffer[amountReceived] = 0;
                        printf("%s\n", buffer);                 //prints messages

                        //sendReceivedMessageToOtherClients(buffer, socketFD);
                }
                if (amountReceived ==0){
                        break;
                }

        }//end while
        close(socketFD);  //closing socket file descriptor

        return NULL;
}

///
int main(int arg1, char *arg2[]){

        //setting up connection to server
        //find port
        int port = atoi(arg2[1]);


        //Call socket function
        int socketFD = createTCPIpv4Socket();
                                                        //ip, port
        struct sockaddr_in *address = createIPv4Address("127.0.0.1", port);
        //              File descriptor, addresss of server we want to connect to, length of address
        int result = connect(socketFD, (struct sockaddr *)address, sizeof(*address));

        if(result == 0){
                printf("Connection was successful \n");
        }

        //asking for name
        char *name = NULL;
        size_t nameSize = 0;
        printf("please enter your name: \n");
        ssize_t nameCount = getline(&name, &nameSize, stdin);
        name[nameCount-1] =0;

        //Sending messages, asking for message from console
        char *line = NULL;
        size_t lineSize = 0;
        printf("You can now send and recieve messagess.\nType \"exit\" to disconnect.\n");

        startListeningAndPrintMessagesOnNewThread(socketFD);

        char buffer[1024];

        while(true){ //reads input from user

                sprintf(buffer, "%s: %s", name, line);  //append name
                ssize_t charCount = getline(&line, &lineSize, stdin);   //amount of characters it read from console
                line[charCount-1]=0;

                sprintf(buffer, "%s:%s", name,line);

                if(charCount >0){
                        if(strcmp(line, "exit") == 0){        //if client says exit, they exit application
                                printf("disconnecting... \n");
                                break;
                        }
                }
                ssize_t amountWasSent = send(socketFD, buffer, strlen(buffer), 0);     //otherwise send message to other side
                if(amountWasSent <0){
                        perror("send failed");
                        break;
                }
        }

        close(socketFD);
        return 0;
}
